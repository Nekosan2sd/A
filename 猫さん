<title>タマヨケ v0.43</title>
<style>
:root{color-scheme:dark;background:#0b1220}*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{width:100%;height:100%;margin:0;overflow:hidden;overscroll-behavior:none;background:#0b1220}
body{position:fixed;inset:0;touch-action:none;user-select:none;-webkit-user-select:none;-webkit-touch-callout:none}
#game{position:absolute;inset:0;display:block;width:100%;height:100%;touch-action:none;background:#0b1220}
#message{position:fixed;z-index:10;left:max(12px,env(safe-area-inset-left));right:max(12px,env(safe-area-inset-right));top:max(12px,env(safe-area-inset-top));padding:12px;border-radius:12px;background:#7f1d1d;color:#fff;font:14px/1.5 system-ui,sans-serif;white-space:pre-wrap;display:none;pointer-events:none}
</style>

<style>
#app-ui{position:fixed;inset:0;z-index:20;pointer-events:none;font-family:-apple-system,BlinkMacSystemFont,"Helvetica Neue",sans-serif;color:#f8fafc}.panel{pointer-events:auto;position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:min(520px,calc(100vw - 24px));max-height:calc(100dvh - 24px);overflow:auto;padding:22px;border:1px solid #475569;border-radius:18px;background:rgba(15,23,42,.97);box-shadow:0 20px 70px #0008;text-align:center;-webkit-overflow-scrolling:touch}.hidden{display:none!important}.menu-panel h1{font-size:36px;margin:0 0 4px}.menu-panel h1 span,.subtitle,.step-title{color:#60a5fa}.menu-panel h2{margin:0 0 8px}.menu-panel button,.menu-panel input,.menu-panel textarea{box-sizing:border-box;width:100%;margin:7px 0;border-radius:12px;border:1px solid #64748b;font-size:17px}.menu-panel button{min-height:48px;background:#2563eb;color:white;font-weight:700;padding:10px}.menu-panel button.secondary{background:#334155}.menu-panel button.danger{background:#991b1b}.menu-panel button:disabled{opacity:.45}.menu-panel input,.menu-panel textarea{padding:10px 12px;background:#0f172a;color:white;-webkit-user-select:text;user-select:text;touch-action:manipulation}.menu-panel textarea{height:104px;resize:vertical;font:12px/1.35 ui-monospace,SFMono-Regular,Menlo,monospace;white-space:pre;overflow:auto}.menu-note{color:#cbd5e1;margin:5px 0 13px}.steps{padding-left:22px;text-align:left;line-height:1.55}.step-box{text-align:left;padding:12px;margin:10px 0;border-radius:12px;background:#1e293b}.step-box p{margin:3px 0 7px}.connection-state{padding:10px;border-radius:10px;background:#172033;color:#bfdbfe}.net-status{position:absolute;top:max(12px,env(safe-area-inset-top));right:max(12px,env(safe-area-inset-right));padding:8px 12px;border-radius:9px;background:#0f172acc;color:#bfdbfe;pointer-events:none}canvas.menu-open{filter:blur(3px) brightness(.45)}
</style>

<style>
#app-ui:before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 50% 36%,rgba(37,99,235,.22),transparent 38%),linear-gradient(135deg,rgba(15,23,42,.88),rgba(2,6,23,.96));pointer-events:none}
#app-ui:after{content:"";position:absolute;inset:0;opacity:.18;background-image:linear-gradient(rgba(96,165,250,.12) 1px,transparent 1px),linear-gradient(90deg,rgba(96,165,250,.12) 1px,transparent 1px);background-size:48px 48px;pointer-events:none;animation:gridDrift 18s linear infinite}
@keyframes gridDrift{to{background-position:48px 48px}}
.menu-panel{border-color:rgba(96,165,250,.45);background:linear-gradient(160deg,rgba(15,23,42,.97),rgba(2,6,23,.95));backdrop-filter:blur(16px);box-shadow:0 24px 90px #000b,0 0 50px rgba(37,99,235,.12)}
.menu-panel h1{letter-spacing:.04em;text-shadow:0 0 28px rgba(96,165,250,.32)}
.menu-kicker{font-size:11px;letter-spacing:.32em;color:#93c5fd;margin-bottom:8px}
.menu-panel button{transition:transform .16s ease,filter .16s ease,border-color .16s ease}.menu-panel button:active{transform:scale(.98)}.menu-panel button:hover{filter:brightness(1.08);border-color:#93c5fd}
.setting-card,.credit-card{text-align:left;background:rgba(30,41,59,.72);border:1px solid #334155;border-radius:14px;padding:15px;margin:12px 0}.setting-row{display:flex;align-items:center;justify-content:space-between;gap:14px;font-weight:700}.menu-panel button.compact{width:auto;min-width:82px;margin:0}.volume-label{display:flex;justify-content:space-between;margin:18px 0 4px}.menu-panel input[type=range]{accent-color:#60a5fa;padding:0}.credit-card p{margin:9px 0;color:#cbd5e1}.credit-card strong{font-size:21px;color:#93c5fd}
</style>

<style>
.weapon-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px;margin:12px 0}.weapon-card{width:100%!important;min-height:108px!important;margin:0!important;padding:11px!important;text-align:left;background:#172033!important;border:1px solid #475569!important}.weapon-card.selected{border-color:#60a5fa!important;background:linear-gradient(145deg,#1d4ed8,#172033)!important;box-shadow:0 0 24px rgba(96,165,250,.22)}.weapon-card strong{display:block;font-size:15px}.weapon-card small{display:block;color:#cbd5e1;margin-top:5px;line-height:1.35}.loadout-heading{text-align:left;color:#bfdbfe;margin:18px 0 8px}.color-grid{display:grid;grid-template-columns:repeat(8,1fr);gap:8px}.color-swatch{aspect-ratio:1;min-height:38px!important;width:100%!important;margin:0!important;padding:0!important;border:3px solid transparent!important;border-radius:50%!important}.color-swatch.selected{border-color:white!important;box-shadow:0 0 0 3px #60a5fa,0 0 20px currentColor}.loadout-summary{text-align:left;margin:14px 0;padding:12px;border-radius:12px;background:#0f172a;color:#dbeafe;font-size:13px;line-height:1.55}@media(max-width:430px){.weapon-grid{grid-template-columns:1fr}.color-grid{grid-template-columns:repeat(4,1fr)}}
</style>
