    }
    if(this.move.pointerId!==null&&this.move.pointerId===this.aim.pointerId)errors.push('左右スティックのPointer ID重複');
    return errors;
  }
}

class FixedStepLoop{
  constructor(update,render){
    this.update=update;this.render=render;
    this.step=CONFIG.fixedStep;this.accumulator=0;this.lastTime=null;
    this.running=false;this.raf=0;this.tick=0;this.droppedTime=0;
    this.frameDelta=0;this.updatesLastFrame=0;
    this.boundFrame=time=>this.frame(time);
  }
  start(){if(this.running)return;this.running=true;this.lastTime=null;this.raf=requestAnimationFrame(this.boundFrame)}
  stop(){this.running=false;cancelAnimationFrame(this.raf)}
  frame(time){
    if(!this.running)return;
    if(this.lastTime===null)this.lastTime=time;
    const rawDelta=Math.max(0,(time-this.lastTime)/1000);
    this.lastTime=time;
    this.frameDelta=Math.min(rawDelta,CONFIG.maxFrameDelta);
    this.droppedTime+=Math.max(0,rawDelta-CONFIG.maxFrameDelta);
    this.accumulator+=this.frameDelta;
    let updates=0;
    while(this.accumulator>=this.step&&updates<CONFIG.maxUpdatesPerFrame){
      this.update(this.step);this.accumulator-=this.step;this.tick++;updates++;
    }
    if(updates===CONFIG.maxUpdatesPerFrame&&this.accumulator>=this.step){this.droppedTime+=this.accumulator;this.accumulator=0}
    this.updatesLastFrame=updates;
    this.render(MathUtil.clamp(this.accumulator/this.step,0,1));
    this.raf=requestAnimationFrame(this.boundFrame);
  }
  resetClock(){this.lastTime=null;this.accumulator=0}
}

const view={width:1,height:1,dpr:1};
const world=new World(CONFIG.worldWidth,CONFIG.worldHeight);
const demo={x:world.width/2,y:world.height/2,previousX:world.width/2,previousY:world.height/2,radius:22,angle:0,hp:100,score:0,deaths:0,respawnRemaining:0,protectionRemaining:0,diagnosticTimer:0,diagnosticErrors:[],fps:0,frames:0,fpsTime:performance.now()};
const input=new InputManager(canvas,()=>view);
const camera=new Camera(world,()=>view);
const spatialGrid=new SpatialGrid(CONFIG.collisionCellSize);
spatialGrid.rebuild(world.walls);
const collision=new CollisionSystem(world,spatialGrid);
const projectiles=new ProjectileSystem(world,spatialGrid);
const accuracy=new AccuracySystem();
const weapon=new WeaponSystem(projectiles,accuracy);
let loop;

function resize(){
  const rect=document.documentElement.getBoundingClientRect();
  view.width=Math.max(1,Math.round(rect.width||innerWidth||1));view.height=Math.max(1,Math.round(rect.height||innerHeight||1));
  view.dpr=Math.min(Math.max(devicePixelRatio||1,1),CONFIG.maxDpr);
  canvas.width=Math.max(1,Math.round(view.width*view.dpr));canvas.height=Math.max(1,Math.round(view.height*view.dpr));
  ctx.setTransform(view.dpr,0,0,view.dpr,0,0);ctx.imageSmoothingEnabled=false;
  input.resize();camera.reset(demo.x,demo.y);loop?.resetClock();
}

function update(dt){
  demo.previousX=demo.x;demo.previousY=demo.y;
  const move=input.movement();
  const moved=collision.moveCircle(demo.x,demo.y,demo.radius,move.x*CONFIG.testSpeed*dt,move.y*CONFIG.testSpeed*dt);
  demo.x=moved.x;demo.y=moved.y;
  if(input.aim.magnitude>CONFIG.deadZone)demo.angle=Math.atan2(input.aim.y,input.aim.x);
  accuracy.update(dt,move.x,move.y);
  const trigger=input.aim.active&&input.aim.magnitude>=CONFIG.fireThreshold;
  weapon.update(dt,trigger,demo.x,demo.y,demo.angle);
  projectiles.update(dt);
  camera.update(demo.x,demo.y,Math.cos(demo.angle)*input.aim.magnitude,Math.sin(demo.angle)*input.aim.magnitude,dt);
  demo.diagnosticTimer+=dt;
  if(demo.diagnosticTimer>=CONFIG.diagnosticsInterval){
    demo.diagnosticTimer=0;demo.diagnosticErrors=[...input.validate(),...world.validate(),...camera.validate(),...spatialGrid.validate(),...weapon.validate(),...projectiles.validate(),...accuracy.validate()];
    if(!Number.isFinite(demo.x+demo.y+demo.angle))demo.diagnosticErrors.push('Player状態に非有限値');
    if(!world.containsCircle(demo.x,demo.y,demo.radius))demo.diagnosticErrors.push('PlayerがWorld境界外');
    if(collision.overlapsAny(demo.x,demo.y,demo.radius))demo.diagnosticErrors.push('Playerが壁内へ侵入');
    const sampled=camera.sample(0.5),screen=camera.worldToScreen(demo.x,demo.y,sampled),roundTrip=camera.screenToWorld(screen.x,screen.y,sampled);
    if(Math.hypot(roundTrip.x-demo.x,roundTrip.y-demo.y)>0.0001)demo.diagnosticErrors.push('座標変換の往復誤差');
  }
}

function circle(x,y,r,fill,stroke,width=1){ctx.beginPath();ctx.arc(x,y,r,0,Math.PI*2);if(fill){ctx.fillStyle=fill;ctx.fill()}if(stroke){ctx.strokeStyle=stroke;ctx.lineWidth=width;ctx.stroke()}}
function drawStick(stick,color){ctx.save();ctx.globalAlpha=stick.active?.85:.55;circle(stick.originX,stick.originY,CONFIG.stickRadius,'#172033','#64748b',3);circle(stick.originX,stick.originY,CONFIG.stickRadius*CONFIG.deadZone,null,'#475569',2);circle(stick.knobX,stick.knobY,CONFIG.knobRadius,stick.active?color:'#94a3b8');ctx.restore()}
function drawWorld(sampled){
  const bounds=camera.visibleBounds(sampled,CONFIG.gridSize);
  ctx.fillStyle='#101827';ctx.fillRect(0,0,view.width,view.height);
  ctx.strokeStyle='#1e2b42';ctx.lineWidth=1;
  const firstX=Math.floor(Math.max(0,bounds.left)/CONFIG.gridSize)*CONFIG.gridSize;
  const lastX=Math.min(world.width,bounds.right);
  for(let wx=firstX;wx<=lastX;wx+=CONFIG.gridSize){
    const a=camera.worldToScreen(wx,Math.max(0,bounds.top),sampled),b=camera.worldToScreen(wx,Math.min(world.height,bounds.bottom),sampled);
    ctx.beginPath();ctx.moveTo(Math.round(a.x)+.5,a.y);ctx.lineTo(Math.round(b.x)+.5,b.y);ctx.stroke();
  }
  const firstY=Math.floor(Math.max(0,bounds.top)/CONFIG.gridSize)*CONFIG.gridSize;
  const lastY=Math.min(world.height,bounds.bottom);
  for(let wy=firstY;wy<=lastY;wy+=CONFIG.gridSize){
    const a=camera.worldToScreen(Math.max(0,bounds.left),wy,sampled),b=camera.worldToScreen(Math.min(world.width,bounds.right),wy,sampled);
    ctx.beginPath();ctx.moveTo(a.x,Math.round(a.y)+.5);ctx.lineTo(b.x,Math.round(b.y)+.5);ctx.stroke();
  }
  for(const wall of world.walls){
    if(wall.x+wall.w<bounds.left||wall.x>bounds.right||wall.y+wall.h<bounds.top||wall.y>bounds.bottom)continue;
    const p=camera.worldToScreen(wall.x,wall.y,sampled);
    ctx.fillStyle='#334155';ctx.fillRect(p.x,p.y,wall.w,wall.h);
    ctx.strokeStyle='#94a3b8';ctx.lineWidth=3;ctx.strokeRect(p.x,p.y,wall.w,wall.h);
  }
  for(const grass of world.landmarks){
    if(grass.x+grass.r<bounds.left||grass.x-grass.r>bounds.right||grass.y+grass.r<bounds.top||grass.y-grass.r>bounds.bottom)continue;
    const p=camera.worldToScreen(grass.x,grass.y,sampled);
    const seed=Math.floor(grass.x*.17+grass.y*.31);
    ctx.save();
    const shadow=ctx.createRadialGradient(p.x,p.y,grass.r*.12,p.x,p.y,grass.r);
    shadow.addColorStop(0,'rgba(8,42,25,.82)');shadow.addColorStop(.62,'rgba(17,68,33,.68)');shadow.addColorStop(1,'rgba(8,34,22,0)');
    circle(p.x,p.y,grass.r,shadow);
    for(let i=0;i<Math.max(20,Math.round(grass.r*.27));i++){
      const a=(i*2.399963+seed*.019)%(Math.PI*2);
      const d=grass.r*Math.sqrt(((i*47+seed*11)%101)/101)*.73;
      const x=p.x+Math.cos(a)*d,y=p.y+Math.sin(a)*d;
      const scale=.72+((i*31+seed)%37)/100;
      const rot=a+Math.sin(i*1.7+seed)*.8;
      ctx.save();ctx.translate(x,y);ctx.rotate(rot);
      ctx.fillStyle=i%4===0?'#315f35':i%4===1?'#3f743b':i%4===2?'#285a35':'#477f3d';
      ctx.beginPath();ctx.ellipse(0,0,grass.r*.18*scale,grass.r*.095*scale,0,0,Math.PI*2);ctx.fill();
      ctx.fillStyle='rgba(111,166,67,.28)';ctx.beginPath();ctx.ellipse(-grass.r*.035,0,grass.r*.095*scale,grass.r*.032*scale,0,0,Math.PI*2);ctx.fill();ctx.restore();
    }
    ctx.restore();
  }
  const topLeft=camera.worldToScreen(0,0,sampled),bottomRight=camera.worldToScreen(world.width,world.height,sampled);
  ctx.strokeStyle='#60a5fa';ctx.lineWidth=5;ctx.strokeRect(topLeft.x,topLeft.y,bottomRight.x-topLeft.x,bottomRight.y-topLeft.y);
}

function drawGrassCover(sampled){
  for(const grass of world.landmarks){
    const p=camera.worldToScreen(grass.x,grass.y,sampled);
    if(p.x+grass.r<0||p.x-grass.r>view.width||p.y+grass.r<0||p.y-grass.r>view.height)continue;
    const seed=Math.floor(grass.x*.17+grass.y*.31);
    ctx.save();
    for(let i=0;i<Math.max(28,Math.round(grass.r*.36));i++){
      const a=(i*2.399963+seed*.027)%(Math.PI*2);
      const d=grass.r*Math.sqrt(((i*59+seed*7)%103)/103)*.82;
      const x=p.x+Math.cos(a)*d,y=p.y+Math.sin(a)*d;
      const scale=.78+((i*23+seed)%42)/100;
      const rot=a+Math.sin(i*1.31+seed)*.95;
      ctx.save();ctx.translate(x,y);ctx.rotate(rot);
      ctx.globalAlpha=.82+((i*17)%16)/100;
      ctx.fillStyle=i%5===0?'#5b913f':i%5===1?'#447d3b':i%5===2?'#356d3c':i%5===3?'#659b43':'#2f6538';
      ctx.beginPath();ctx.ellipse(0,0,grass.r*.16*scale,grass.r*.078*scale,0,0,Math.PI*2);ctx.fill();
      ctx.fillStyle='rgba(150,194,84,.32)';ctx.beginPath();ctx.ellipse(-grass.r*.035,0,grass.r*.08*scale,grass.r*.022*scale,0,0,Math.PI*2);ctx.fill();
      ctx.restore();
    }
    ctx.restore();
  }
}
function render(alpha){
  const sampled=camera.sample(alpha);
  drawWorld(sampled);
  const playerX=demo.previousX+(demo.x-demo.previousX)*alpha,playerY=demo.previousY+(demo.y-demo.previousY)*alpha;
  const screen=camera.worldToScreen(playerX,playerY,sampled);
  for(const p of projectiles.items){
