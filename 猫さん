class Camera{
  constructor(world,getView){
    this.world=world;this.getView=getView;
    this.x=0;this.y=0;this.previousX=0;this.previousY=0;
    this.lookX=0;this.lookY=0;this.previousLookX=0;this.previousLookY=0;
  }
  reset(targetX,targetY){
    this.lookX=this.lookY=this.previousLookX=this.previousLookY=0;
    const position=this.clampPosition(targetX,targetY);
    this.x=this.previousX=position.x;this.y=this.previousY=position.y;
  }
  clampAxis(value,viewportSize,worldSize){
    const half=viewportSize/2;
    if(viewportSize>=worldSize)return worldSize/2;
    return MathUtil.clamp(value,half,worldSize-half);
  }
  clampPosition(x,y){
    const view=this.getView();
    return{
      x:this.clampAxis(x,view.width,this.world.width),
      y:this.clampAxis(y,view.height,this.world.height)
    };
  }
  update(targetX,targetY,aimX,aimY,dt){
    this.previousX=this.x;this.previousY=this.y;
    this.previousLookX=this.lookX;this.previousLookY=this.lookY;
    const aim=MathUtil.normalize(aimX,aimY);
    const wantedLookX=aim.x*CONFIG.cameraLookAhead;
    const wantedLookY=aim.y*CONFIG.cameraLookAhead;
    const lookBlend=1-Math.exp(-CONFIG.cameraLookAheadRate*dt);
    this.lookX+=(wantedLookX-this.lookX)*lookBlend;
    this.lookY+=(wantedLookY-this.lookY)*lookBlend;
    const desired=this.clampPosition(targetX+this.lookX,targetY+this.lookY);
    const distance=Math.hypot(desired.x-this.x,desired.y-this.y);
    if(distance>CONFIG.cameraDeadZone){
      const followBlend=1-Math.exp(-CONFIG.cameraFollowRate*dt);
      this.x+=(desired.x-this.x)*followBlend;
      this.y+=(desired.y-this.y)*followBlend;
    }
    const clamped=this.clampPosition(this.x,this.y);
    this.x=clamped.x;this.y=clamped.y;
  }
  sample(alpha){
    const amount=MathUtil.clamp(alpha,0,1);
    return{
      x:this.previousX+(this.x-this.previousX)*amount,
      y:this.previousY+(this.y-this.previousY)*amount,
      lookX:this.previousLookX+(this.lookX-this.previousLookX)*amount,
      lookY:this.previousLookY+(this.lookY-this.previousLookY)*amount
    };
  }
  worldToScreen(x,y,sampled){
    const view=this.getView();
    return{x:x-sampled.x+view.width/2,y:y-sampled.y+view.height/2};
  }
  screenToWorld(x,y,sampled){
    const view=this.getView();
    return{x:x+sampled.x-view.width/2,y:y+sampled.y-view.height/2};
  }
  visibleBounds(sampled,padding=0){
    const view=this.getView();
    return{left:sampled.x-view.width/2-padding,top:sampled.y-view.height/2-padding,right:sampled.x+view.width/2+padding,bottom:sampled.y+view.height/2+padding};
  }
  validate(){
    const errors=[];
    if(!Number.isFinite(this.x+this.y+this.previousX+this.previousY+this.lookX+this.lookY))errors.push('Cameraに非有限値');
    const clamped=this.clampPosition(this.x,this.y);
    if(Math.abs(clamped.x-this.x)>0.001||Math.abs(clamped.y-this.y)>0.001)errors.push('CameraがWorld境界外');
    return errors;
  }
}

class SpatialGrid{
  constructor(cellSize){
    if(!Number.isFinite(cellSize)||cellSize<=0)throw new Error('SpatialGridのセルサイズが不正です。');
    this.cellSize=cellSize;this.cells=new Map();this.items=new Map();this.queryStamp=0;
  }
  key(x,y){return `${x},${y}`}
  range(item,padding=0){
    return{
      minX:Math.floor((item.x-padding)/this.cellSize),
      minY:Math.floor((item.y-padding)/this.cellSize),
      maxX:Math.floor((item.x+item.w+padding)/this.cellSize),
      maxY:Math.floor((item.y+item.h+padding)/this.cellSize)
    };
  }
  insert(item){
    if(!item||item.id==null||![item.x,item.y,item.w,item.h].every(Number.isFinite)||item.w<0||item.h<0)throw new Error('SpatialGridへ不正な要素が渡されました。');
    this.remove(item.id);this.items.set(item.id,item);
    const range=this.range(item),keys=[];
    for(let y=range.minY;y<=range.maxY;y++)for(let x=range.minX;x<=range.maxX;x++){
      const key=this.key(x,y);let cell=this.cells.get(key);
      if(!cell){cell=new Set();this.cells.set(key,cell)}
      cell.add(item);keys.push(key);
    }
    item.__gridKeys=keys;
  }
  remove(id){
    const item=this.items.get(id);if(!item)return;
    for(const key of item.__gridKeys||[]){const cell=this.cells.get(key);if(!cell)continue;cell.delete(item);if(cell.size===0)this.cells.delete(key)}
    delete item.__gridKeys;this.items.delete(id);
  }
  rebuild(items){this.clear();for(const item of items)this.insert(item)}
  clear(){for(const item of this.items.values())delete item.__gridKeys;this.cells.clear();this.items.clear()}
  queryAABB(x,y,w,h,padding=0){
    const box={x,y,w,h},range=this.range(box,padding),result=[],stamp=++this.queryStamp;
    for(let cy=range.minY;cy<=range.maxY;cy++)for(let cx=range.minX;cx<=range.maxX;cx++){
      const cell=this.cells.get(this.key(cx,cy));if(!cell)continue;
      for(const item of cell){if(item.__queryStamp===stamp)continue;item.__queryStamp=stamp;result.push(item)}
    }
    return result;
  }
  queryCircle(x,y,radius){return this.queryAABB(x-radius,y-radius,radius*2,radius*2)}
  validate(){
    const errors=[];
    for(const [id,item] of this.items){if(id!==item.id)errors.push('SpatialGridのID不一致');if(!item.__gridKeys?.length)errors.push(`SpatialGrid未登録: ${id}`)}
    return errors;
  }
}

class CollisionSystem{
  constructor(world,grid){this.world=world;this.grid=grid;this.lastCandidates=0;this.lastContacts=0}
  circleRectContact(x,y,radius,rect){
    const nearestX=MathUtil.clamp(x,rect.x,rect.x+rect.w),nearestY=MathUtil.clamp(y,rect.y,rect.y+rect.h);
    let dx=x-nearestX,dy=y-nearestY,distSq=dx*dx+dy*dy;
    if(distSq>=radius*radius)return null;
    if(distSq>Number.EPSILON){const distance=Math.sqrt(distSq);return{nx:dx/distance,ny:dy/distance,depth:radius-distance}}
    const left=x-rect.x,right=rect.x+rect.w-x,top=y-rect.y,bottom=rect.y+rect.h-y;
    const minimum=Math.min(left,right,top,bottom);
    if(minimum===left)return{nx:-1,ny:0,depth:radius+left};
    if(minimum===right)return{nx:1,ny:0,depth:radius+right};
    if(minimum===top)return{nx:0,ny:-1,depth:radius+top};
    return{nx:0,ny:1,depth:radius+bottom};
  }
  depenetrate(x,y,radius,candidates){
    let px=x,py=y,contacts=0;
    for(let iteration=0;iteration<CONFIG.collisionIterations;iteration++){
      let changed=false;
      for(const wall of candidates){const contact=this.circleRectContact(px,py,radius,wall);if(!contact)continue;
        px+=contact.nx*(contact.depth+CONFIG.collisionEpsilon);py+=contact.ny*(contact.depth+CONFIG.collisionEpsilon);contacts++;changed=true;
      }
      const bounded=this.world.clampCircle(px,py,radius);px=bounded.x;py=bounded.y;
      if(!changed)break;
    }
    return{x:px,y:py,contacts};
  }
  moveCircle(x,y,radius,dx,dy){
    if(![x,y,radius,dx,dy].every(Number.isFinite))return{x,y,contacts:0,candidates:0};
    const distance=Math.hypot(dx,dy),maxStep=Math.max(1,radius*.45),steps=Math.max(1,Math.ceil(distance/maxStep));
    let px=x,py=y,totalContacts=0,candidateCount=0;
    for(let step=0;step<steps;step++){
      px+=dx/steps;py+=dy/steps;
      const bounded=this.world.clampCircle(px,py,radius);px=bounded.x;py=bounded.y;
      const candidates=this.grid.queryCircle(px,py,radius+2);candidateCount=Math.max(candidateCount,candidates.length);
      const solved=this.depenetrate(px,py,radius,candidates);px=solved.x;py=solved.y;totalContacts+=solved.contacts;
    }
    this.lastCandidates=candidateCount;this.lastContacts=totalContacts;
    return{x:px,y:py,contacts:totalContacts,candidates:candidateCount};
  }
  overlapsAny(x,y,radius){for(const wall of this.grid.queryCircle(x,y,radius))if(this.circleRectContact(x,y,radius,wall))return true;return false}
}

class AccuracySystem{
  constructor(){
    this.move=0;
    this.prevX=0;
    this.prevY=0;
    this.turn=0;
    this.bloom=0;
    this.recoil=0;
    this.index=0;
    this.since=999;
    this.drift=0;
    this.spread=CONFIG.spreadStandingDeg;
    this.gap=CONFIG.reticleMinGap;
    this.pulse=0;
    this.spare=null;
    this.pattern=[0,0.16,-0.12,0.24,-0.2,0.3,-0.26,0.18,-0.14,0.08];
  }

  gaussian(){
    if(this.spare!==null){
      const value=this.spare;
      this.spare=null;
      return value;
    }

    let u=0;
    let v=0;
    while(!u)u=Math.random();
    while(!v)v=Math.random();

    const magnitude=Math.sqrt(-2*Math.log(u));
    const angle=2*Math.PI*v;
    this.spare=magnitude*Math.sin(angle);
    return magnitude*Math.cos(angle);
  }

  angle(baseAngle){
    const raw=this.gaussian();
    const limited=MathUtil.clamp(raw,-CONFIG.gaussianLimit,CONFIG.gaussianLimit);
    const fresh=limited/CONFIG.gaussianLimit;

    this.drift=
      this.drift*CONFIG.spreadDriftMemory+
      fresh*(1-CONFIG.spreadDriftMemory);

    const sample=
      fresh*(1-CONFIG.spreadDriftWeight)+
      this.drift*CONFIG.spreadDriftWeight;

    const patternOffset=this.pattern[this.index%this.pattern.length];
    const totalOffsetDeg=this.recoil+patternOffset+sample*this.spread;
    return baseAngle+totalOffsetDeg*Math.PI/180;
  }

  shot(){
    this.bloom=Math.min(
      CONFIG.shotBloomMaxDeg,
      this.bloom+CONFIG.shotBloomPerShotDeg
    );
    this.recoil=Math.min(
      CONFIG.recoilMaxDeg,
      this.recoil+CONFIG.recoilStepDeg
    );
    this.index++;
    this.since=0;
    this.pulse=1;
  }

  update(dt,inputX,inputY){
    this.since+=dt;

    const movement=MathUtil.clamp(Math.hypot(inputX,inputY),0,1);
    const movementCurve=movement*movement;
    const previousLength=Math.hypot(this.prevX,this.prevY);

    if(movement>0.08&&previousLength>0.08){
      const dot=MathUtil.clamp(
        (inputX*this.prevX+inputY*this.prevY)/(movement*previousLength),
        -1,
        1
      );
      this.turn=Math.max(
        this.turn,
        CONFIG.turnSpreadMaxDeg*(1-dot)*0.5
      );
    }

    this.move=movement;
    this.prevX=inputX;
    this.prevY=inputY;
    this.turn*=Math.exp(-CONFIG.turnSpreadDecay*dt);

    if(this.since>=CONFIG.recoveryDelay){
      this.bloom*=Math.exp(-CONFIG.bloomRecovery*dt);
      this.recoil*=Math.exp(-CONFIG.recoilRecovery*dt);
      this.drift*=Math.exp(-4*dt);

      if(this.bloom<0.015){
        this.bloom=0;
        this.index=0;
      }
      if(this.recoil<0.008)this.recoil=0;
    }

    const bloomRatio=MathUtil.clamp(
      this.bloom/CONFIG.shotBloomMaxDeg,
      0,
      1
    );
    const bloomCurve=Math.pow(bloomRatio,CONFIG.bloomCurvePower);
    const runSpread=CONFIG.runGunBonusDeg*movementCurve*bloomCurve;
    const targetSpread=MathUtil.clamp(
      CONFIG.spreadStandingDeg+
      CONFIG.spreadMovingDeg*movementCurve+
      CONFIG.shotBloomMaxDeg*bloomCurve+
      this.turn+
      runSpread,
      CONFIG.spreadStandingDeg,
      CONFIG.maxTotalSpreadDeg
    );

    const spreadBlend=1-Math.exp(-CONFIG.spreadResponse*dt);
    this.spread+=(targetSpread-this.spread)*spreadBlend;

    const spreadRatio=MathUtil.clamp(
      this.spread/CONFIG.maxTotalSpreadDeg,
      0,
      1
    );
    const targetGap=
      CONFIG.reticleMinGap+
      (CONFIG.reticleMaxGap-CONFIG.reticleMinGap)*Math.pow(spreadRatio,0.75)+
      this.pulse*7;
    const reticleBlend=1-Math.exp(-CONFIG.reticleResponse*dt);
    this.gap+=(targetGap-this.gap)*reticleBlend;
    this.pulse*=Math.exp(-CONFIG.reticlePulseDecay*dt);
  }

  validate(){
    const values=[
      this.move,
      this.turn,
      this.bloom,
      this.recoil,
      this.drift,
      this.spread,
      this.gap
    ];
    const errors=[];

    if(!values.every(Number.isFinite)){
      errors.push('精度状態に非有限値');
    }
    if(this.spread<0||this.spread>CONFIG.maxTotalSpreadDeg+0.01){
      errors.push('拡散率が範囲外');
    }
    if(this.recoil<0||this.recoil>CONFIG.recoilMaxDeg+0.01){
      errors.push('反動が範囲外');
    }
    return errors;
  }
}

class ProjectileSystem{
  constructor(world,grid){this.world=world;this.grid=grid;this.items=[];this.pool=[];this.nextId=1;this.impacts=[];this.totalSpawned=0;this.totalImpacts=0}
  spawn(x,y,angle,speed=CONFIG.projectileSpeed,options={}){
    if(![x,y,angle,speed].every(Number.isFinite)||this.items.length>=CONFIG.maxProjectiles)return false;
    const p=this.pool.pop()||{};p.id=this.nextId++;p.x=x;p.y=y;p.previousX=x;p.previousY=y;p.vx=Math.cos(angle)*speed;p.vy=Math.sin(angle)*speed;p.life=CONFIG.projectileLife;p.radius=options.radius||CONFIG.projectileRadius;p.weaponId=options.weaponId||1;p.damage=options.damage||25;p.bounces=options.bounces||0;p.tracerColor=options.color||'#fde68a';p.active=true;
    this.items.push(p);this.totalSpawned++;return true;
  }
  segmentAABB(x0,y0,x1,y1,rect,padding=0){
    const minX=rect.x-padding,maxX=rect.x+rect.w+padding,minY=rect.y-padding,maxY=rect.y+rect.h+padding,dx=x1-x0,dy=y1-y0;
    let near=0,far=1,nx=0,ny=0;
    for(const axis of [{p:x0,d:dx,min:minX,max:maxX,nx:-1,ny:0},{p:y0,d:dy,min:minY,max:maxY,nx:0,ny:-1}]){
      if(Math.abs(axis.d)<1e-12){if(axis.p<axis.min||axis.p>axis.max)return null;continue}
      let a=(axis.min-axis.p)/axis.d,b=(axis.max-axis.p)/axis.d,enterNormal={x:axis.nx,y:axis.ny};
      if(a>b){[a,b]=[b,a];enterNormal.x*=-1;enterNormal.y*=-1}
      if(a>near){near=a;nx=enterNormal.x;ny=enterNormal.y}far=Math.min(far,b);if(near>far)return null;
    }
    if(near<0||near>1)return null;return{t:near,x:x0+dx*near,y:y0+dy*near,nx,ny};
  }
  firstWallHit(x0,y0,x1,y1,radius){
    const minX=Math.min(x0,x1)-radius,minY=Math.min(y0,y1)-radius,w=Math.abs(x1-x0)+radius*2,h=Math.abs(y1-y0)+radius*2;
    let best=null;
