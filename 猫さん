<body>
<div id="app-ui" aria-live="polite">
  <section id="main-menu" class="panel menu-panel">
    <div class="menu-kicker">2D TACTICAL ACTION</div><h1>タマヨケ <span>v0.42</span></h1>
    <p class="subtitle">静寂から、一瞬の判断へ。</p><p class="menu-note">既存のゲーム性能と対戦機能はそのまま維持</p>
    <input id="player-name" maxlength="16" value="Player" aria-label="プレイヤー名">
    <button id="solo-btn">1人で練習</button>
    <button id="multi-btn">ネット対戦</button>
    <button id="help-btn" class="secondary">操作方法</button>
    <button id="loadout-btn" class="secondary">武器・キャラ</button>
    <button id="settings-btn" class="secondary">設定</button>
    <button id="credits-btn" class="secondary">クレジット</button>
  </section>
  <section id="multi-menu" class="panel menu-panel hidden">
    <h2>ネット対戦の接続</h2>
    <p class="menu-note">各端末で同じHTMLをSafariから開きます。専用ホスト運用ではホスト端末を常に前面表示してください。</p>
    <button id="create-room-btn">端末A：ホストになる</button>
    <button id="join-room-btn">端末B：参加する</button>
    <button data-back class="secondary">戻る</button>
  </section>
  <section id="host-panel" class="panel menu-panel hidden">
    <h2>端末A：ホスト</h2>
    <div class="step-box"><strong class="step-title">1. ホストコードを送る</strong><p>下のコードをコピーして端末Bへ送ります。</p><textarea id="host-code-out" readonly spellcheck="false"></textarea><button id="copy-host-btn">ホストコードをコピー</button></div>
    <div class="step-box"><strong class="step-title">2. 参加コードを受け取る</strong><p>端末Bが作った参加コードを貼り付けます。先頭や末尾の改行は自動で除去されます。</p><textarea id="answer-code-in" spellcheck="false" placeholder="参加コードをここへ貼り付け"></textarea><button id="apply-answer-btn">参加コードを読み込む</button></div>
    <p id="host-state" class="connection-state">ホストコードを作成しています…</p>
    <button id="start-match-btn" disabled>接続後にゲーム開始</button>
    <button data-back class="secondary">中止して戻る</button>
  </section>
  <section id="join-panel" class="panel menu-panel hidden">
    <h2>端末B：参加</h2>
    <div class="step-box"><strong class="step-title">1. ホストコードを貼る</strong><textarea id="offer-code-in" spellcheck="false" placeholder="端末Aのホストコードをここへ貼り付け"></textarea><button id="make-answer-btn">ホストコードを読み込む</button></div>
    <div class="step-box"><strong class="step-title">2. 参加コードを返す</strong><p>生成後、コピーして端末Aへ返します。</p><textarea id="answer-code-out" readonly spellcheck="false"></textarea><button id="copy-answer-btn" disabled>参加コードをコピー</button></div>
    <p id="join-state" class="connection-state">ホストコードを待っています。</p>
    <button data-back class="secondary">中止して戻る</button>
  </section>
  <section id="help-panel" class="panel menu-panel hidden">
    <h2>操作方法</h2><ul class="steps"><li>左側ドラッグ：移動</li><li>右側ドラッグ：照準と射撃</li><li>2人対戦：ホストコード → 参加コードの順に1往復だけ交換</li><li>接続中はSafariを画面の手前に保つ</li></ul><button data-back class="secondary">戻る</button>
  </section>


  <section id="loadout-panel" class="panel menu-panel hidden">
    <h2>武器・キャラ設定</h2>
    <p class="menu-note">武器を1つ選択してください。選択内容は保存されます。</p>
    <div id="weapon-grid" class="weapon-grid"></div>
    <h3 class="loadout-heading">キャラクターカラー</h3>
    <div id="color-grid" class="color-grid" aria-label="キャラクターカラー"></div>
    <div id="loadout-summary" class="loadout-summary"></div>
    <button data-back class="secondary">決定して戻る</button>
  </section>
  <section id="settings-panel" class="panel menu-panel hidden">
    <h2>設定</h2>
    <div class="setting-card"><div class="setting-row"><label for="bgm-toggle">メニューBGM</label><button id="bgm-toggle" class="compact">ON</button></div><label class="volume-label" for="bgm-volume">BGM音量 <span id="bgm-volume-value">35%</span></label><input id="bgm-volume" type="range" min="0" max="100" value="35" aria-label="BGM音量"></div>
    <p class="menu-note">設定はこの端末のブラウザーに保存されます。</p>
    <button data-back class="secondary">戻る</button>
  </section>
  <section id="credits-panel" class="panel menu-panel hidden">
    <h2>クレジット</h2>
    <div class="credit-card"><strong>タマヨケ</strong><p>企画・方向性：0423_中川</p><p>ゲーム実装支援：Microsoft Copilot</p><p>メニューBGM：オリジナル生成音源</p><p>バージョン：v0.43</p></div>
    <button data-back class="secondary">戻る</button>
  </section>
  <div id="net-status" class="net-status hidden"></div>
</div>
<audio id="menu-bgm" preload="auto" loop src="data:audio/wav;base64,"></audio>
<canvas id="game" class="menu-open" aria-label="タマヨケ ゲーム画面"></canvas>
<div id="message" role="alert"></div>
<script>

const MenuAudio=(()=>{
 const audio=document.getElementById('menu-bgm');
 let enabled=localStorage.getItem('tamayoke-bgm-enabled')!=='0';
 let volume=Math.max(0,Math.min(1,Number(localStorage.getItem('tamayoke-bgm-volume')??.35)));
 let fading=0;
 const apply=()=>{audio.volume=enabled?volume:0;const b=document.getElementById('bgm-toggle');if(b)b.textContent=enabled?'ON':'OFF';const r=document.getElementById('bgm-volume');if(r)r.value=String(Math.round(volume*100));const v=document.getElementById('bgm-volume-value');if(v)v.textContent=Math.round(volume*100)+'%'};
 const play=()=>{if(!enabled)return;clearInterval(fading);apply();audio.play().catch(()=>{});};
 const stop=()=>{clearInterval(fading);const from=audio.volume,start=performance.now();fading=setInterval(()=>{const p=Math.min(1,(performance.now()-start)/350);audio.volume=from*(1-p);if(p>=1){clearInterval(fading);audio.pause();audio.currentTime=0;apply()}},30)};
 const init=()=>{apply();document.getElementById('bgm-toggle').onclick=()=>{enabled=!enabled;localStorage.setItem('tamayoke-bgm-enabled',enabled?'1':'0');enabled?play():stop();apply()};document.getElementById('bgm-volume').oninput=e=>{volume=Number(e.target.value)/100;localStorage.setItem('tamayoke-bgm-volume',String(volume));apply();if(enabled)play()};document.addEventListener('pointerdown',()=>{if(!document.getElementById('app-ui').classList.contains('hidden'))play()},{once:true});};
 return{init,play,stop};
})();
const WEAPONS=Object.freeze([
{id:1,name:'AR-24',type:'AR',mag:24,rate:9,reload:1.35,speed:1350,damage:25,radius:3,pellets:1,spread:.18,color:'#fde68a',desc:'万能型アサルトライフル'},
{id:2,name:'Viper-32',type:'SMG',mag:32,rate:13,reload:1.15,speed:1050,damage:14,radius:3,pellets:1,spread:2.4,color:'#fb923c',desc:'高速連射の近距離型'},
{id:3,name:'Atlas-60',type:'LMG',mag:60,rate:10,reload:3.2,speed:1250,damage:18,radius:3.5,pellets:1,spread:1.25,color:'#fbbf24',desc:'大容量の制圧射撃'},
{id:4,name:'Trident',type:'BURST',mag:27,rate:3.1,reload:1.6,speed:1450,damage:22,radius:3,pellets:3,spread:.75,color:'#fef3c7',desc:'3点バースト'},
{id:5,name:'Falcon-10',type:'DMR',mag:10,rate:3,reload:1.9,speed:1850,damage:45,radius:3,pellets:1,spread:.08,color:'#fff7ed',desc:'高精度セミオート'},
{id:6,name:'Longshot',type:'BOLT',mag:5,rate:.8,reload:3,speed:2200,damage:90,radius:3.5,pellets:1,spread:.04,color:'#ffffff',desc:'超高速・高威力'},
{id:7,name:'Breaker-6',type:'SHOTGUN',mag:6,rate:1.1,reload:2.6,speed:950,damage:9,radius:3,pellets:8,spread:11,color:'#ffb86b',desc:'8粒の近距離散弾'},
{id:8,name:'Hammer',type:'SLUG',mag:5,rate:1,reload:2.4,speed:1100,damage:65,radius:7,pellets:1,spread:.45,color:'#ff7043',desc:'大口径スラッグ弾'},
{id:9,name:'Magnum-6',type:'REVOLVER',mag:6,rate:2.4,reload:2.1,speed:1500,damage:38,radius:3.5,pellets:1,spread:.16,color:'#ffd166',desc:'高威力リボルバー'},
{id:10,name:'Pulse-Caster',type:'PLASMA',mag:12,rate:2.5,reload:1.8,speed:500,damage:30,radius:9,pellets:1,spread:.2,color:'#67e8f9',desc:'大きく遅いプラズマ弾'},
{id:11,name:'Volt-Lance',type:'CHARGE',mag:8,rate:.85,reload:2.2,speed:1800,damage:70,radius:5,pellets:1,spread:.1,color:'#a5f3fc',desc:'最大チャージ相当の一撃'},
{id:12,name:'Ricochet-8',type:'RICOCHET',mag:8,rate:2,reload:2,speed:900,damage:28,radius:4,pellets:1,spread:.3,color:'#facc15',bounces:1,desc:'壁で1回反射'}
]);
const CHARACTER_COLORS=Object.freeze(['#34d399','#60a5fa','#a78bfa','#f472b6','#fb7185','#f97316','#facc15','#e2e8f0']);
let activeWeapon=WEAPONS.find(w=>w.id===Number(localStorage.getItem('tamayoke-weapon')))||WEAPONS[0];
let playerColor=CHARACTER_COLORS.includes(localStorage.getItem('tamayoke-player-color'))?localStorage.getItem('tamayoke-player-color'):CHARACTER_COLORS[0];
const Loadout=(()=>{
 const $=id=>document.getElementById(id);
 function render(){
  $('weapon-grid').innerHTML=WEAPONS.map(w=>`<button class="weapon-card ${w.id===activeWeapon.id?'selected':''}" data-weapon="${w.id}"><strong>${w.id}. ${w.name}</strong><small>${w.desc}<br>${w.mag}発 / ${w.rate}発秒 / 弾速${w.speed}</small></button>`).join('');
  $('color-grid').innerHTML=CHARACTER_COLORS.map(c=>`<button class="color-swatch ${c===playerColor?'selected':''}" data-color="${c}" style="background:${c};color:${c}" aria-label="${c}"></button>`).join('');
  $('loadout-summary').innerHTML=`<strong>${activeWeapon.name}</strong><br>装弾 ${activeWeapon.mag}　連射 ${activeWeapon.rate}/秒　弾速 ${activeWeapon.speed}<br>ダメージ ${activeWeapon.damage}　リロード ${activeWeapon.reload}秒`;
  document.querySelectorAll('[data-weapon]').forEach(b=>b.onclick=()=>{activeWeapon=WEAPONS.find(w=>w.id===Number(b.dataset.weapon));localStorage.setItem('tamayoke-weapon',String(activeWeapon.id));weapon?.resetForWeapon?.();render()});
  document.querySelectorAll('[data-color]').forEach(b=>b.onclick=()=>{playerColor=b.dataset.color;localStorage.setItem('tamayoke-player-color',playerColor);render()});
 }
 return{init:render,render};
})();
const Multiplayer=(()=>{
'use strict';
const $=id=>document.getElementById(id);
const peers=new Map();
let pc=null,dc=null,isHost=false,live=false,last=0;
const setStatus=t=>{$('net-status').textContent=t;$('net-status').classList.toggle('hidden',!t)};
const setPanel=id=>{document.querySelectorAll('#app-ui .panel').forEach(p=>p.classList.add('hidden'));$(id).classList.remove('hidden')};
const hideMenus=()=>{$('app-ui').classList.add('hidden');$('game').classList.remove('menu-open');MenuAudio.stop()};
const normalizeCode=value=>String(value??'').replace(/^\uFEFF/,'').replace(/[\u200B-\u200D\u2060]/g,'').replace(/\s+/g,'').trim();
const pack=description=>btoa(unescape(encodeURIComponent(JSON.stringify(description))));
const unpack=value=>{const clean=normalizeCode(value);if(!clean)throw new Error('接続コードが空です。');return JSON.parse(decodeURIComponent(escape(atob(clean))))};
const copy=async(text,button)=>{const clean=normalizeCode(text);try{await navigator.clipboard.writeText(clean);button.textContent='コピーしました';setTimeout(()=>button.textContent=button.dataset.label,1400)}catch{const area=button.previousElementSibling;area.focus();area.select();document.execCommand('copy');button.textContent='選択しました。コピーしてください'}};
const waitIce=()=>new Promise((resolve,reject)=>{if(!pc)return reject(new Error('接続準備がありません。'));if(pc.iceGatheringState==='complete')return resolve();const timer=setTimeout(()=>{pc.removeEventListener('icegatheringstatechange',check);reject(new Error('接続情報の作成がタイムアウトしました。'))},12000);function check(){if(pc&&pc.iceGatheringState==='complete'){clearTimeout(timer);pc.removeEventListener('icegatheringstatechange',check);resolve()}}pc.addEventListener('icegatheringstatechange',check)});
const send=obj=>{if(dc&&dc.readyState==='open'&&dc.bufferedAmount<262144)dc.send(JSON.stringify(obj))};
function attachChannel(channel){dc=channel;dc.binaryType='arraybuffer';dc.onopen=()=>{live=true;setStatus('WebRTC 接続中');send({t:'hello',name:$('player-name').value||'Player'});$('host-state').textContent='接続完了。ゲームを開始できます。';$('join-state').textContent='接続完了。ホストの開始操作を待っています。';$('start-match-btn').disabled=false;$('start-match-btn').textContent='ゲーム開始'};dc.onclose=()=>{live=false;peers.clear();setStatus('接続が切れました')};dc.onerror=()=>setStatus('データ通信エラー');dc.onmessage=e=>{let m;try{m=JSON.parse(e.data)}catch{return}if(m.t==='hello')peers.set('peer',{name:m.name,updated:performance.now()});if(m.t==='start')hideMenus();if(m.t==='state')peers.set('peer',{...(peers.get('peer')||{}),...m.state,updated:performance.now()});if(m.t==='event')window.dispatchEvent(new CustomEvent('tamayoke-peer-event',{detail:{event:m.event,data:m.data}}))}}
function makePeer(){if(!window.RTCPeerConnection)throw new Error('このSafariではWebRTCを利用できません。Safariを更新してください。');if(pc)pc.close();pc=new RTCPeerConnection({iceServers:[]});pc.ondatachannel=e=>attachChannel(e.channel);pc.oniceconnectionstatechange=()=>{const s=pc.iceConnectionState;setStatus('接続状態: '+s);if(s==='failed'){$('host-state').textContent=$('join-state').textContent='接続失敗。同じWi-Fiか確認し、最初からやり直してください。'}}}
async function createHost(){try{isHost=true;setPanel('host-panel');makePeer();attachChannel(pc.createDataChannel('tamayoke',{ordered:false,maxRetransmits:0}));await pc.setLocalDescription(await pc.createOffer());await waitIce();$('host-code-out').value=pack(pc.localDescription);$('host-code-out').scrollTop=0;$('host-state').textContent='ホストコードを端末Bへ送ってください。'}catch(e){$('host-state').textContent='作成失敗: '+e.message}}
async function makeAnswer(){try{isHost=false;$('join-state').textContent='参加コードを作成しています…';makePeer();await pc.setRemoteDescription(unpack($('offer-code-in').value));await pc.setLocalDescription(await pc.createAnswer());await waitIce();$('answer-code-out').value=pack(pc.localDescription);$('answer-code-out').scrollTop=0;$('copy-answer-btn').disabled=false;$('join-state').textContent='参加コードを端末Aへ返してください。'}catch(e){$('join-state').textContent='読み込み失敗: '+e.message}}
async function applyAnswer(){try{$('host-state').textContent='参加コードを確認しています…';await pc.setRemoteDescription(unpack($('answer-code-in').value));$('host-state').textContent='接続処理中です。数秒お待ちください。'}catch(e){$('host-state').textContent='読み込み失敗: '+e.message}}
