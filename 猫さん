class WeaponSystem{
  constructor(projectiles,accuracy){this.projectiles=projectiles;this.accuracy=accuracy;this.resetForWeapon();this.shots=0;this.dryFires=0;this.triggerHeld=false;this.muzzleFlash=0}
  resetForWeapon(){this.magazine=activeWeapon.mag;this.cooldown=0;this.reloadRemaining=0}
  update(dt,trigger,x,y,angle){this.cooldown=Math.max(0,this.cooldown-dt);this.muzzleFlash=Math.max(0,this.muzzleFlash-dt);if(this.reloadRemaining>0){this.reloadRemaining=Math.max(0,this.reloadRemaining-dt);if(this.reloadRemaining===0)this.magazine=activeWeapon.mag;return}this.triggerHeld=trigger;if(!trigger)return;if(this.magazine<=0){this.startReload();return}if(this.cooldown<=0){this.fire(x,y,angle);this.cooldown+=1/activeWeapon.rate}}
