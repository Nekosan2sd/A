    if(stick.pointerId!==null){this.ignoredPointers.add(event.pointerId);return;}
    stick.pointerId=event.pointerId;
    stick.active=true;
    stick.captured=false;
    stick.originX=point.x;stick.originY=point.y;
    stick.knobX=point.x;stick.knobY=point.y;
    stick.x=stick.y=stick.magnitude=0;
    stick.lastEventTime=performance.now();
    stick.sequence=++this.sequence;
    try{
      this.target.setPointerCapture(event.pointerId);
