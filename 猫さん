      if(!stick.active&&(stick.x!==0||stick.y!==0||stick.magnitude!==0))errors.push(`${stick.name}: 非アクティブ入力残留`);
      if(!Number.isFinite(stick.x+stick.y+stick.magnitude))errors.push(`${stick.name}: 非有限値`);
