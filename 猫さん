}
class InputManager{
  constructor(target,getView){
    this.target=target;
    this.getView=getView;
    this.keys=new Set();
    this.ignoredPointers=new Set();
    this.enabled=true;
    this.sequence=0;
    this.lastResetReason='initial';
    this.move=this.createStick('move');
    this.aim=this.createStick('aim');
    this.handlers=[];
    this.bind();
  }
  createStick(name){return{name,pointerId:null,active:false,captured:false,originX:0,originY:0,knobX:0,knobY:0,x:0,y:0,magnitude:0,lastEventTime:0,sequence:0}}
  listen(target,type,handler,options){target.addEventListener(type,handler,options);this.handlers.push([target,type,handler,options])}
  bind(){
    this.listen(this.target,'pointerdown',event=>this.onPointerDown(event),{passive:false});
    this.listen(this.target,'pointermove',event=>this.onPointerMove(event),{passive:false});
    this.listen(this.target,'pointerup',event=>this.endPointer(event.pointerId,'canvas-up'),{passive:false});
    this.listen(this.target,'pointercancel',event=>this.endPointer(event.pointerId,'canvas-cancel'),{passive:false});
    this.listen(this.target,'lostpointercapture',event=>this.onLostCapture(event),{passive:true});
    this.listen(this.target,'pointerleave',event=>this.onPointerExit(event),{passive:true});
    this.listen(this.target,'pointerout',event=>this.onPointerExit(event),{passive:true});
    this.listen(window,'pointerup',event=>this.endPointer(event.pointerId,'window-up'),true);
    this.listen(window,'pointercancel',event=>this.endPointer(event.pointerId,'window-cancel'),true);
    this.listen(document,'pointerup',event=>this.endPointer(event.pointerId,'document-up'),true);
    this.listen(document,'pointercancel',event=>this.endPointer(event.pointerId,'document-cancel'),true);
    this.listen(window,'keydown',event=>this.onKey(event,true),{passive:false});
    this.listen(window,'keyup',event=>this.onKey(event,false),{passive:false});
    this.listen(window,'blur',()=>this.reset('blur'));
    this.listen(window,'pagehide',()=>this.reset('pagehide'));
    this.listen(window,'pageshow',()=>this.reset('pageshow'));
    this.listen(document,'visibilitychange',()=>{if(document.hidden)this.reset('hidden')});
